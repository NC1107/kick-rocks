# Where the encrypted database and its key file live.
KICKROCKS_DATA_DIR=./data
# Bind address and port for the web UI and API.
KICKROCKS_HOST=127.0.0.1
KICKROCKS_PORT=8420
# trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info
# The address people and agents use to reach the server, for links shown in the UI.
# Defaults to http://localhost:<port>.
KICKROCKS_PUBLIC_URL=
# Extra hostnames, comma separated, that may be used in the address bar besides localhost, IP
# addresses, and the host of KICKROCKS_PUBLIC_URL. Any other name is refused, which stops a web page
# from reaching the server by DNS rebinding.
KICKROCKS_ALLOWED_HOSTS=
# Behind a reverse proxy you control, set this to the number of proxies in front of the server (1 for
# one) or to a comma separated list of their addresses, so the login throttle and the Secure cookie
# flag see each client's real address and scheme. Leave it empty when the server is reached directly.
KICKROCKS_TRUST_PROXY=
# Turns on the worker API. Set it to a random string of at least 16 characters and give the
# same value to the worker. Leave it empty to keep the worker API off.
KICKROCKS_WORKER_TOKEN=
# A JSON file of extra brokers and companies, for fixtures and power users.
KICKROCKS_EXTRA_TARGETS=
# A directory of extra recipe files.
KICKROCKS_EXTRA_RECIPES=
# on | off. The scheduler is on by default; tests turn it off.
KICKROCKS_SCHEDULER=on
# Comma separated hostnames the confirmation link follower may reach even though they resolve to a
# private or loopback address. Leave it empty unless you run a local fixture site for testing.
KICKROCKS_ALLOW_PRIVATE_LINK_HOSTS=
# The pause between two sends from one mailbox, in milliseconds, as "<ms>" or "<min>-<max>".
# Defaults to 20000-60000 so a mail provider does not see a burst. Leave it unset for real mail.
KICKROCKS_SEND_GAP_MS=
# Comma separated hostnames the mailbox may reach without TLS, besides this machine.
# Leave it empty: a real provider must always be reached over TLS.
KICKROCKS_PLAINTEXT_MAIL_HOSTS=
