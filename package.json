{
  "name": "kick-rocks",
  "version": "0.0.0",
  "private": true,
  "description": "Self-hosted tool that tells data brokers and companies to kick rocks: sends opt-out and deletion requests from your own mailbox, drives broker forms, and tracks every reply.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/**' --filter './apps/**' build",
    "dev": "pnpm -r --parallel --filter @kickrocks/server --filter @kickrocks/web dev",
    "dev:worker": "pnpm --filter @kickrocks/worker dev",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test && pnpm test:scripts",
    "test:scripts": "node --test scripts/check-standards.test.mjs scripts/install.test.mjs scripts/trust-copy.test.mjs",
    "standards": "node scripts/check-standards.mjs",
    "data:build": "pnpm --filter @kickrocks/shared build && pnpm --filter @kickrocks/brokers build:data",
    "e2e": "pnpm --filter @kickrocks/e2e e2e",
    "loop:coverage": "pnpm --filter @kickrocks/server exec tsx ../../scripts/loops/coverage/run.mts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.0",
    "typescript": "^5.9.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "argon2",
      "better-sqlite3-multiple-ciphers",
      "esbuild"
    ]
  }
}
