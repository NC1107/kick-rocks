{
  "name": "kick-rocks",
  "version": "0.0.0",
  "private": true,
  "description": "Self-hosted tool that tells data brokers and companies to kick rocks: sends opt-out and deletion requests from your own mailbox, drives broker forms, and tracks every reply.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/**' --filter './apps/**' build",
    "dev": "pnpm -r --parallel --filter './apps/**' dev",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "data:build": "pnpm --filter @kickrocks/shared build && pnpm --filter @kickrocks/brokers build:data"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.0",
    "typescript": "^5.9.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3-multiple-ciphers",
      "esbuild"
    ]
  }
}
