{
  "id": "beenverified.remove.v1",
  "brokerId": "beenverified",
  "version": 1,
  "purpose": "remove",
  "entryUrl": "https://www.beenverified.com/app/optout/search",
  "fields": ["first_name", "last_name", "state", "email", "record_url"],
  "steps": [
    {
      "kind": "goto",
      "url": "https://www.beenverified.com/app/optout/search"
    },
    {
      "kind": "captcha_checkpoint"
    },
    {
      "kind": "fill",
      "target": {
        "label": "First Name"
      },
      "field": "first_name"
    },
    {
      "kind": "fill",
      "target": {
        "label": "Last Name"
      },
      "field": "last_name"
    },
    {
      "kind": "select",
      "target": {
        "label": "State"
      },
      "value": "{{state|state_name}}"
    },
    {
      "kind": "click",
      "target": {
        "role": "button",
        "label": "Search"
      }
    },
    {
      "kind": "select_record",
      "item": {
        "css": "a[href*='/optout/'], a[href*='/people/']"
      },
      "link": {
        "css": ":scope",
        "attr": "href"
      },
      "action": "click"
    },
    {
      "kind": "fill",
      "target": {
        "label": "Email"
      },
      "field": "email"
    },
    {
      "kind": "captcha_checkpoint"
    },
    {
      "kind": "email_confirmation",
      "fromDomain": "beenverified.com"
    },
    {
      "kind": "click",
      "target": {
        "role": "button",
        "label": "Submit"
      }
    },
    {
      "kind": "outcome_when",
      "when": [
        {
          "text": "has been sent",
          "outcome": "awaiting_email_confirmation"
        },
        {
          "text": "we have sent",
          "outcome": "awaiting_email_confirmation"
        },
        {
          "text": "we've sent",
          "outcome": "awaiting_email_confirmation"
        },
        {
          "text": "we sent",
          "outcome": "awaiting_email_confirmation"
        },
        {
          "text": "sent you an email",
          "outcome": "awaiting_email_confirmation"
        },
        {
          "text": "sent an email",
          "outcome": "awaiting_email_confirmation"
        },
        {
          "text": "check your inbox",
          "outcome": "awaiting_email_confirmation"
        }
      ]
    }
  ],
  "canary": {
    "url": "https://www.beenverified.com/app/optout/search",
    "selectors": [
      {
        "label": "First Name"
      },
      {
        "label": "Last Name"
      }
    ]
  },
  "notes": "Not verified. The opt-out search page redirects to /svc/optout/search/ and answered with a Cloudflare Turnstile interstitial in headless and headed Chrome on 2026-10-07, so no form was seen and no challenge was solved. The steps follow the site's published flow (search by name and state, pick the record, give an email, confirm by email) with label-based selectors that are unverified. Expect a bot_detection block until a human or agent clears it. The wording the site shows after Submit was never observed, so the outcome_when texts that prove the request went through are guesses, and the recipe stays unverified until a real submission has been seen. A search that lists results but none matching the record stops the run for a person instead of closing the request as not found, because the result links may not take the shape a scan reads and this recipe does not claim its list is complete.",
  "verifiedAt": "2026-10-07",
  "liveStatus": "unverified"
}
