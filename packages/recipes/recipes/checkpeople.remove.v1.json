{
  "id": "checkpeople.remove.v1",
  "brokerId": "checkpeople",
  "version": 1,
  "purpose": "remove",
  "entryUrl": "https://www.checkpeople.com/opt-out",
  "fields": ["email"],
  "steps": [
    {
      "kind": "goto",
      "url": "https://www.checkpeople.com/opt-out"
    },
    {
      "kind": "fill",
      "target": {
        "css": "form.cp-auto-optout__form #requestorEmail"
      },
      "field": "email"
    },
    {
      "kind": "check",
      "target": {
        "css": "form.cp-auto-optout__form #acknowledge"
      },
      "optional": true
    },
    {
      "kind": "captcha_checkpoint"
    },
    {
      "kind": "email_confirmation",
      "fromDomain": "checkpeople.com"
    },
    {
      "kind": "click",
      "target": {
        "css": "form.cp-auto-optout__form button.cp-auto-optout__button"
      }
    },
    {
      "kind": "outcome_when",
      "when": [
        {
          "text": "has been sent",
          "outcome": "awaiting_email_confirmation"
        },
        {
          "text": "we have sent",
          "outcome": "awaiting_email_confirmation"
        },
        {
          "text": "we've sent",
          "outcome": "awaiting_email_confirmation"
        },
        {
          "text": "we sent",
          "outcome": "awaiting_email_confirmation"
        },
        {
          "text": "sent you an email",
          "outcome": "awaiting_email_confirmation"
        },
        {
          "text": "sent an email",
          "outcome": "awaiting_email_confirmation"
        },
        {
          "text": "check your inbox",
          "outcome": "awaiting_email_confirmation"
        }
      ]
    }
  ],
  "canary": {
    "url": "https://www.checkpeople.com/opt-out",
    "selectors": [
      {
        "css": "form.cp-auto-optout__form #requestorEmail"
      },
      {
        "css": "form.cp-auto-optout__form button.cp-auto-optout__button"
      }
    ]
  },
  "notes": "Verified live 2026-10-07 in headed Chrome: the \"Suppression Center\" page takes one email address and says it will send a verification link before anything else. The acknowledgement checkbox #acknowledge exists but is reported hidden (it is probably a styled control), so the check step is optional. Later steps, behind the emailed link, were not opened. Headless Chrome got a Cloudflare challenge. Nothing was submitted. The wording the site shows after Submit was never observed, so the outcome_when texts that prove the request went through are guesses, and the recipe stays unverified until a real submission has been seen.",
  "verifiedAt": "2026-10-07",
  "liveStatus": "unverified"
}
