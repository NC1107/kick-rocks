{
  "id": "checkpeople.scan.v1",
  "brokerId": "checkpeople",
  "version": 1,
  "purpose": "scan",
  "entryUrl": "https://www.checkpeople.com/",
  "fields": ["first_name", "last_name", "city", "state"],
  "steps": [
    {
      "kind": "goto",
      "url": "https://www.checkpeople.com/"
    },
    {
      "kind": "fill",
      "target": {
        "css": "#heroFirstName"
      },
      "field": "first_name"
    },
    {
      "kind": "fill",
      "target": {
        "css": "#heroLastName"
      },
      "field": "last_name"
    },
    {
      "kind": "fill",
      "target": {
        "css": "#heroCity"
      },
      "field": "city"
    },
    {
      "kind": "select",
      "target": {
        "css": "#heroState"
      },
      "field": "state",
      "by": "value"
    },
    {
      "kind": "click",
      "target": {
        "css": "#heroTabPeople button.btn-search, #heroTabPeople button[type='submit']"
      }
    },
    {
      "kind": "captcha_checkpoint"
    },
    {
      "kind": "wait_for",
      "target": {
        "css": "[class*='result'] a[href]"
      },
      "optional": true
    },
    {
      "kind": "extract_candidates",
      "item": {
        "css": "[class*='result'], [class*='record'], article"
      },
      "fields": {
        "recordUrl": {
          "css": "a[href]",
          "attr": "href"
        },
        "name": {
          "css": "h2, h3, a"
        },
        "age": {
          "css": "[class*='age']"
        },
        "locations": {
          "css": "[class*='location'], [class*='address']",
          "all": true
        }
      }
    }
  ],
  "canary": {
    "url": "https://www.checkpeople.com/",
    "selectors": [
      {
        "css": "#heroFirstName"
      },
      {
        "css": "#heroLastName"
      },
      {
        "css": "#heroCity"
      },
      {
        "css": "#heroState"
      }
    ]
  },
  "notes": "Partly verified 2026-10-07. The home page search form (#heroTabPeople: heroFirstName, heroLastName, heroCity, heroState with two-letter values) was read in headed Chrome. It posts to a /landing funnel, and name result pages (/name/...) answered with a Cloudflare challenge, so the results markup was never seen and the extract_candidates selectors are unverified guesses. The search also appears to lead into a paid funnel, so it may not list records at all.",
  "verifiedAt": "2026-10-07",
  "liveStatus": "blocked_by_bot_protection"
}
