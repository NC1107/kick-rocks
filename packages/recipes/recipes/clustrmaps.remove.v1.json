          "outcome": "awaiting_email_confirmation"
        },
        {
          "text": "we've sent",
          "outcome": "awaiting_email_confirmation"
        },
        {
          "text": "we sent",
          "outcome": "awaiting_email_confirmation"
        },
        {
          "text": "sent you an email",
          "outcome": "awaiting_email_confirmation"
        },
        {
          "text": "sent an email",
          "outcome": "awaiting_email_confirmation"
        },
        {
          "text": "check your inbox",
          "outcome": "awaiting_email_confirmation"
        }
      ]
    }
  ],
  "canary": {
    "url": "https://clustrmaps.com/bl/opt-out",
    "selectors": [
