{
  "id": "familytreenow.scan.v1",
  "brokerId": "familytreenow",
  "version": 1,
  "purpose": "scan",
  "entryUrl": "https://www.familytreenow.com/",
  "fields": ["first_name", "last_name"],
  "steps": [
    {
      "kind": "goto",
      "url": "https://www.familytreenow.com/"
    },
    {
      "kind": "captcha_checkpoint"
    },
    {
      "kind": "fill",
      "target": {
        "label": "First Name"
      },
      "field": "first_name"
    },
    {
      "kind": "fill",
      "target": {
        "label": "Last Name"
      },
      "field": "last_name"
    },
    {
      "kind": "click",
      "target": {
        "role": "button",
        "label": "Search"
      }
    },
    {
      "kind": "captcha_checkpoint"
    },
    {
      "kind": "wait_for",
      "target": {
        "css": "a[href*='/record/'], a[href*='/people/']"
      },
      "optional": true
    },
    {
      "kind": "extract_candidates",
      "item": {
        "css": "[class*='result'], article, tr"
      },
      "fields": {
        "recordUrl": {
          "css": "a[href]",
          "attr": "href"
        },
        "name": {
          "css": "h2, h3, a"
        },
        "age": {
          "css": "[class*='age']"
        },
        "locations": {
          "css": "[class*='location'], [class*='address']",
          "all": true
        },
        "relatives": {
          "css": "[class*='relative'] a",
          "all": true
        }
      }
    }
  ],
  "canary": {
    "url": "https://www.familytreenow.com/",
    "selectors": [
      {
        "label": "First Name"
      },
      {
        "label": "Last Name"
      }
    ]
  },
  "notes": "Not verified. Every familytreenow.com page, including the opt-out page, answered with a Cloudflare Turnstile \"Performing security verification\" interstitial on 2026-10-07 in headless and headed Chrome, and no challenge was solved. The selectors are label-based guesses. Expect a bot_detection block.",
  "verifiedAt": "2026-10-07",
  "liveStatus": "blocked_by_bot_protection"
}
