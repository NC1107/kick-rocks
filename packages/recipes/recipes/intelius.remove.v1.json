{
  "id": "intelius.remove.v1",
  "brokerId": "intelius",
  "alsoFor": ["peopleconnect"],
  "version": 1,
  "purpose": "remove",
  "entryUrl": "https://suppression.peopleconnect.us/?brand=Intelius",
  "fields": ["email"],
  "steps": [
    {
      "kind": "goto",
      "url": "https://suppression.peopleconnect.us/?brand=Intelius"
    },
    {
      "kind": "fill",
      "target": {
        "css": "input[name=\"login-email\"]"
      },
      "field": "email"
    },
    {
      "kind": "check",
      "target": {
        "css": "input[name=\"consent\"]"
      }
    },
    {
      "kind": "captcha_checkpoint"
    },
    {
      "kind": "email_confirmation",
      "fromDomain": "peopleconnect.us"
    },
    {
      "kind": "click",
      "target": {
        "css": "form button[type=\"submit\"]"
      }
    },
    {
      "kind": "outcome_when",
      "when": [
        {
          "text": "has been sent",
          "outcome": "awaiting_email_confirmation"
        },
        {
          "text": "we have sent",
          "outcome": "awaiting_email_confirmation"
        },
        {
          "text": "we've sent",
          "outcome": "awaiting_email_confirmation"
        },
        {
          "text": "we sent",
          "outcome": "awaiting_email_confirmation"
        },
        {
          "text": "sent you an email",
          "outcome": "awaiting_email_confirmation"
        },
        {
          "text": "sent an email",
          "outcome": "awaiting_email_confirmation"
        },
        {
          "text": "check your inbox",
          "outcome": "awaiting_email_confirmation"
        }
      ]
    }
  ],
  "canary": {
    "url": "https://suppression.peopleconnect.us/?brand=Intelius",
    "selectors": [
      {
        "css": "input[name=\"login-email\"]"
      },
      {
        "css": "input[name=\"consent\"]"
      },
      {
        "css": "form button[type=\"submit\"]"
      }
    ],
    "steps": []
  },
  "notes": "Verified live 2026-10-07 in headless Chrome. Intelius removes public records through the PeopleConnect suppression center: the privacy center's \"Manage My Suppression Rules\" link opens https://suppression.peopleconnect.us/?brand=Intelius in a new tab, so the recipe goes there directly. That page asks for an email address and a consent box and then emails a verification link, which the confirm task follows. The user-data tools on the privacy center (copy of data, delete user data) are a different right and are not used. Nothing was submitted. The wording the site shows after Submit was never observed, so the outcome_when texts that prove the request went through are guesses, and the recipe stays unverified until a real submission has been seen.",
  "verifiedAt": "2026-10-07",
  "liveStatus": "unverified"
}
