{
  "id": "mylife.remove.v1",
  "brokerId": "mylife",
  "version": 1,
  "purpose": "remove",
  "entryUrl": "https://www.mylife.com/privacyrequest",
  "fields": ["first_name", "last_name", "city", "state", "zip", "birth_year", "email"],
  "steps": [
    {
      "kind": "goto",
      "url": "https://www.mylife.com/privacyrequest"
    },
    {
      "kind": "wait_for",
      "target": {
        "css": "#first_6"
      },
      "frame": {
        "css": "iframe[src*=\"mylife.jotform.com\"]"
      }
    },
    {
      "kind": "fill",
      "target": {
        "css": "#first_6"
      },
      "field": "first_name",
      "frame": {
        "css": "iframe[src*=\"mylife.jotform.com\"]"
      }
    },
    {
      "kind": "fill",
      "target": {
        "css": "#last_6"
      },
      "field": "last_name",
      "frame": {
        "css": "iframe[src*=\"mylife.jotform.com\"]"
      }
    },
    {
      "kind": "fill",
      "target": {
        "css": "#input_11_city"
      },
      "field": "city",
      "frame": {
        "css": "iframe[src*=\"mylife.jotform.com\"]"
      }
    },
    {
      "kind": "select",
      "target": {
        "css": "#input_21"
      },
      "value": "{{state|state_name}}",
      "frame": {
        "css": "iframe[src*=\"mylife.jotform.com\"]"
      }
    },
    {
      "kind": "fill",
      "target": {
        "css": "#input_11_postal"
      },
      "field": "zip",
      "frame": {
        "css": "iframe[src*=\"mylife.jotform.com\"]"
      }
    },
    {
      "kind": "fill",
      "target": {
        "css": "#input_15"
      },
      "field": "birth_year",
      "frame": {
        "css": "iframe[src*=\"mylife.jotform.com\"]"
      }
    },
    {
      "kind": "fill",
      "target": {
        "css": "#input_7"
      },
      "field": "email",
      "frame": {
        "css": "iframe[src*=\"mylife.jotform.com\"]"
      },
      "optional": true
    },
    {
      "kind": "captcha_checkpoint"
    },
    {
      "kind": "click",
      "target": {
        "css": "#input_2"
      },
      "frame": {
        "css": "iframe[src*=\"mylife.jotform.com\"]"
      }
    },
    {
      "kind": "outcome_when",
      "when": [
        {
          "text": "has been submitted",
          "outcome": "submitted"
        },
        {
          "text": "has been received",
          "outcome": "submitted"
        },
        {
          "text": "successfully submitted",
          "outcome": "submitted"
        },
        {
          "text": "we have received your request",
          "outcome": "submitted"
        },
        {
          "text": "we received your request",
          "outcome": "submitted"
        }
      ]
    }
  ],
  "canary": {
    "url": "https://www.mylife.com/privacyrequest",
    "selectors": [
      {
        "css": "iframe[src*=\"mylife.jotform.com\"]"
      },
      {
        "css": "#first_6"
      },
      {
        "css": "#last_6"
      },
      {
        "css": "#input_11_city"
      },
      {
        "css": "#input_21"
      },
      {
        "css": "#input_11_postal"
      },
      {
        "css": "#input_15"
      },
      {
        "css": "#input_2"
      }
    ]
  },
  "notes": "Verified live 2026-10-07 in headed Chrome. The page embeds a Jotform (mylife.jotform.com) in an iframe, and the form fields were read by loading the embed address directly: state select #input_21, name #first_6 and #last_6, city #input_11_city, postal #input_11_postal, birth year #input_15, a reCAPTCHA, and the Submit button #input_2. The state select lists full state names, so the recipe selects by label with the state name. The email input #input_7 is hidden on load and is filled only when it shows. The form has no confirmation email step on its face, so a submit completes as submitted. The canary checks the iframe and the fields inside it. Headless Chrome got 403 on the entry page. Nothing was submitted. The wording the site shows after Submit was never observed, so the outcome_when texts that prove the request went through are guesses, and the recipe stays unverified until a real submission has been seen. Re-checked 2026-10-07 in a plain headed Chrome: the Jotform iframe is on /privacyrequest and a reCAPTCHA is shown, so a run stops for a person at the captcha checkpoint. The steps do not name the frame because a step without a frame searches the page and every frame.",
  "verifiedAt": "2026-10-07",
  "liveStatus": "unverified"
}
