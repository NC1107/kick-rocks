{
  "id": "nuwber.remove.v1",
  "brokerId": "nuwber",
  "version": 1,
  "purpose": "remove",
  "entryUrl": "https://nuwber.com/removal/link",
  "fields": ["record_url", "email"],
  "steps": [
    {
      "kind": "goto",
      "url": "https://nuwber.com/removal/link"
    },
    {
      "kind": "fill",
      "target": {
        "css": "input[type='url'], input[name*='url' i]"
      },
      "field": "record_url"
    },
    {
      "kind": "fill",
      "target": {
        "css": "input[type='email']"
      },
      "field": "email"
    },
    {
      "kind": "captcha_checkpoint"
    },
    {
      "kind": "email_confirmation",
      "fromDomain": "nuwber.com"
    },
    {
      "kind": "click",
      "target": {
        "css": "form button[type='submit']"
      }
    },
    {
      "kind": "outcome_when",
      "when": [
        {
          "text": "has been sent",
          "outcome": "awaiting_email_confirmation"
        },
        {
          "text": "we have sent",
          "outcome": "awaiting_email_confirmation"
        },
        {
          "text": "we've sent",
          "outcome": "awaiting_email_confirmation"
        },
        {
          "text": "we sent",
          "outcome": "awaiting_email_confirmation"
        },
        {
          "text": "sent you an email",
          "outcome": "awaiting_email_confirmation"
        },
        {
          "text": "sent an email",
          "outcome": "awaiting_email_confirmation"
        },
        {
          "text": "check your inbox",
          "outcome": "awaiting_email_confirmation"
        }
      ]
    }
  ],
  "canary": {
    "url": "https://nuwber.com/removal/link",
    "selectors": [
      {
        "css": "input[type='email']"
      },
      {
        "css": "form button[type='submit']"
      }
    ]
  },
  "notes": "Not verified. nuwber.com did not resolve in DNS from this machine on 2026-10-07, so the opt-out page at the address in the broker dataset was never loaded. The steps follow the site's published flow (paste the profile link, give an email, confirm by email link) with generic selectors that are guesses. Check whether the site is still operating before relying on this recipe. The wording the site shows after Submit was never observed, so the outcome_when texts that prove the request went through are guesses, and the recipe stays unverified until a real submission has been seen.",
  "verifiedAt": "2026-10-07",
  "liveStatus": "unverified"
}
