{
  "id": "smartbackgroundchecks.scan.v1",
  "brokerId": "smartbackgroundchecks",
  "version": 1,
  "purpose": "scan",
  "entryUrl": "https://www.smartbackgroundchecks.com/",
  "fields": ["first_name", "last_name", "city", "state"],
  "steps": [
    {
      "kind": "goto",
      "url": "https://www.smartbackgroundchecks.com/"
    },
    {
      "kind": "fill",
      "target": {
        "css": "#inputFirstName"
      },
      "field": "first_name"
    },
    {
      "kind": "fill",
      "target": {
        "css": "#inputLastName"
      },
      "field": "last_name"
    },
    {
      "kind": "fill",
      "target": {
        "css": "#inputCityState"
      },
      "value": "{{city}}, {{state}}"
    },
    {
      "kind": "press",
      "key": "Enter",
      "target": {
        "css": "#inputCityState"
      }
    },
    {
      "kind": "captcha_checkpoint"
    },
    {
      "kind": "wait_for",
      "target": {
        "css": "a[href^='/people/']"
      },
      "optional": true
    },
    {
      "kind": "extract_candidates",
      "item": {
        "css": ".card-block"
      },
      "fields": {
        "recordUrl": {
          "css": "a[href^='/people/']",
          "attr": "href"
        },
        "name": {
          "css": "h2, h3"
        },
        "age": {
          "css": "[class*='age'], h2, h3"
        },
        "locations": {
          "css": "[class*='address'], [class*='location']",
          "all": true
        },
        "relatives": {
          "css": "a[href^='/people/']",
          "all": true
        }
      }
    }
  ],
  "canary": {
    "url": "https://www.smartbackgroundchecks.com/",
    "selectors": [
      {
        "css": "#inputFirstName"
      },
      {
        "css": "#inputLastName"
      },
      {
        "css": "#inputCityState"
      }
    ]
  },
  "notes": "Partly verified 2026-10-07. The home page search form (inputFirstName, inputLastName, inputCityState, which posts to /search.php) was read in headed Chrome. Running the search and every /people/ page answered with a Cloudflare challenge, so the results markup was never seen and the extract_candidates selectors are unverified guesses. Expect a bot_detection block.",
  "verifiedAt": "2026-10-07",
  "liveStatus": "blocked_by_bot_protection"
}
