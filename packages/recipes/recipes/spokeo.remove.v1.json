{
  "id": "spokeo.remove.v1",
  "brokerId": "spokeo",
  "version": 1,
  "purpose": "remove",
  "entryUrl": "https://www.spokeo.com/optout",
  "fields": ["record_url", "email"],
  "steps": [
    {
      "kind": "goto",
      "url": "https://www.spokeo.com/optout"
    },
    {
      "kind": "fill",
      "target": {
        "css": "form[name=\"optout-form\"] input[name=\"url\"]"
      },
      "field": "record_url"
    },
    {
      "kind": "fill",
      "target": {
        "css": "form[name=\"optout-form\"] input[name=\"email\"]"
      },
      "field": "email"
    },
    {
      "kind": "captcha_checkpoint"
    },
    {
      "kind": "email_confirmation",
      "fromDomain": "spokeo.com"
    },
    {
      "kind": "click",
      "target": {
        "css": "form[name=\"optout-form\"] button[type=\"submit\"]"
      }
    },
    {
      "kind": "outcome_when",
      "when": [
        {
          "text": "has been sent",
          "outcome": "awaiting_email_confirmation"
        },
        {
          "text": "we have sent",
          "outcome": "awaiting_email_confirmation"
        },
        {
          "text": "we've sent",
          "outcome": "awaiting_email_confirmation"
        },
        {
          "text": "we sent",
          "outcome": "awaiting_email_confirmation"
        },
        {
          "text": "sent you an email",
          "outcome": "awaiting_email_confirmation"
        },
        {
          "text": "sent an email",
          "outcome": "awaiting_email_confirmation"
        },
        {
          "text": "check your inbox",
          "outcome": "awaiting_email_confirmation"
        }
      ]
    }
  ],
  "canary": {
    "url": "https://www.spokeo.com/optout",
    "selectors": [
      {
        "css": "form[name=\"optout-form\"]"
      },
      {
        "css": "form[name=\"optout-form\"] input[name=\"url\"]"
      },
      {
        "css": "form[name=\"optout-form\"] input[name=\"email\"]"
      },
      {
        "css": "form[name=\"optout-form\"] button[type=\"submit\"]"
      }
    ]
  },
  "notes": "Verified live 2026-10-07 in headed Chrome: the opt-out form takes a profile URL and an email address and no captcha was present on load. Spokeo then emails a confirmation link, which the confirm task follows. Submission and the page after it were not exercised. Headless Chrome got 403. A real Chrome on a residential connection was used for every check, no challenge was solved, and nothing was submitted. The wording the site shows after Submit was never observed, so the outcome_when texts that prove the request went through are guesses, and the recipe stays unverified until a real submission has been seen. Re-checked 2026-10-07 in a plain headed Chrome: the form and its url, email and submit controls are unchanged (canary healthy).",
  "verifiedAt": "2026-10-07",
  "liveStatus": "unverified"
}
