{
  "id": "usphonebook.remove.v1",
  "brokerId": "usphonebook",
  "version": 1,
  "purpose": "remove",
  "entryUrl": "https://www.usphonebook.com/removal",
  "fields": ["first_name", "last_name", "email"],
  "steps": [
    {
      "kind": "goto",
      "url": "https://www.usphonebook.com/removal"
    },
    {
      "kind": "select",
      "target": {
        "css": "form#verifyEmailForm select#user-type"
      },
      "value": "The subject of the request"
    },
    {
      "kind": "fill",
      "target": {
        "css": "form#verifyEmailForm #subject-firstname"
      },
      "field": "first_name"
    },
    {
      "kind": "fill",
      "target": {
        "css": "form#verifyEmailForm #subject-lastname"
      },
      "field": "last_name"
    },
    {
      "kind": "fill",
      "target": {
        "css": "form#verifyEmailForm #subject-email"
      },
      "field": "email"
    },
    {
      "kind": "check",
      "target": {
        "css": "form#verifyEmailForm #agreement"
      }
    },
    {
      "kind": "captcha_checkpoint"
    },
    {
      "kind": "email_confirmation",
      "fromDomain": "usphonebook.com"
    },
    {
      "kind": "click",
      "target": {
        "css": "form#verifyEmailForm #BRP"
      }
    },
    {
      "kind": "outcome_when",
      "when": [
        {
          "text": "has been sent",
          "outcome": "awaiting_email_confirmation"
        },
        {
          "text": "we have sent",
          "outcome": "awaiting_email_confirmation"
        },
        {
          "text": "we've sent",
          "outcome": "awaiting_email_confirmation"
        },
        {
          "text": "we sent",
          "outcome": "awaiting_email_confirmation"
        },
        {
          "text": "sent you an email",
          "outcome": "awaiting_email_confirmation"
        },
        {
          "text": "sent an email",
          "outcome": "awaiting_email_confirmation"
        },
        {
          "text": "check your inbox",
          "outcome": "awaiting_email_confirmation"
        }
      ]
    }
  ],
  "canary": {
    "url": "https://www.usphonebook.com/removal",
    "selectors": [
      {
        "css": "form#verifyEmailForm select#user-type"
      },
      {
        "css": "form#verifyEmailForm #subject-firstname"
      },
      {
        "css": "form#verifyEmailForm #subject-lastname"
      },
      {
        "css": "form#verifyEmailForm #subject-email"
      },
      {
        "css": "form#verifyEmailForm #agreement"
      },
      {
        "css": "form#verifyEmailForm #BRP"
      }
    ]
  },
  "notes": "Verified live 2026-10-07 in headed Chrome. /opt-out redirects to /removal, whose form#verifyEmailForm has a requester select, first, middle and last name, email, an agreement checkbox, a reCAPTCHA Enterprise widget, and a \"Begin Removal Process\" button #BRP. The page says it will confirm the request by email, so the run ends as awaiting_email_confirmation. Only the subject path is used. Nothing was submitted. The wording the site shows after Submit was never observed, so the outcome_when texts that prove the request went through are guesses, and the recipe stays unverified until a real submission has been seen. Re-checked 2026-10-07 in a plain headed Chrome: every selector is still present (the form, requester select, names, email, agreement and #BRP).",
  "verifiedAt": "2026-10-07",
  "liveStatus": "unverified"
}
