{
  "id": "whitepages.scan.v1",
  "brokerId": "whitepages",
  "version": 1,
  "purpose": "scan",
  "entryUrl": "https://www.whitepages.com/",
  "fields": ["full_name", "city", "state"],
  "steps": [
    {
      "kind": "goto",
      "url": "https://www.whitepages.com/"
    },
    {
      "kind": "fill",
      "target": {
        "css": "#search-name"
      },
      "field": "full_name"
    },
    {
      "kind": "fill",
      "target": {
        "css": "#search-location"
      },
      "value": "{{city}}, {{state}}"
    },
    {
      "kind": "click",
      "target": {
        "css": "#wp-search"
      }
    },
    {
      "kind": "captcha_checkpoint"
    },
    {
      "kind": "wait_for",
      "target": {
        "css": "a[href^=\"/name/\"]"
      },
      "optional": true
    },
    {
      "kind": "extract_candidates",
      "item": {
        "css": "[data-qa-selector=\"serp-card\"], .serp-card"
      },
      "fields": {
        "recordUrl": {
          "css": "a[href^=\"/name/\"]",
          "attr": "href"
        },
        "name": {
          "css": "h2, h3"
        },
        "age": {
          "css": "h2, h3"
        },
        "locations": {
          "css": "a[href*='/address/'], [class*='location']",
          "all": true
        }
      }
    }
  ],
  "canary": {
    "url": "https://www.whitepages.com/",
    "selectors": [
      {
        "css": "#search-name"
      },
      {
        "css": "#search-location"
      },
      {
        "css": "#wp-search"
      }
    ]
  },
  "notes": "Re-checked 2026-10-07 in headed Chrome from a residential connection. The home page search form (#search-name, #search-location and the #wp-search button) is there and typing a name and city with human pacing submits it to /name/John-Smith/Houston-TX, but the results page is a DataDome challenge (a captcha-delivery iframe and an otherwise empty page), in a plain Chrome and in a Playwright launched one, and no challenge was solved. The results markup was never seen, so the extract_candidates selectors are an unverified guess and the scan is expected to end as blocked for a person. The Whitepages opt-out flow does not need a scan result, only the listing URL.",
  "verifiedAt": "2026-10-07",
  "liveStatus": "blocked_by_bot_protection"
}
